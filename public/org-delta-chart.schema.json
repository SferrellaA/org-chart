{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-delta-chart.dev/schema/org-delta-chart.schema.json",
  "title": "Org Delta Chart document",
  "type": "object",
  "required": ["title", "nodes", "snapshots", "proposals"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/nodeDefinition" }
    },
    "snapshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/snapshot" }
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" }
    },
    "presentation": { "$ref": "#/$defs/presentation" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "source": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "imageSymbol": {
      "type": "object",
      "required": ["type", "url", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" },
        "url": { "type": "string", "pattern": "^https?://" },
        "alt": { "type": "string" }
      }
    },
    "textSymbol": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "symbol": {
      "oneOf": [
        { "$ref": "#/$defs/imageSymbol" },
        { "$ref": "#/$defs/textSymbol" }
      ]
    },
    "bundledRankMarker": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bundled" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "imageRankMarker": {
      "type": "object",
      "required": ["type", "url", "alt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" },
        "url": { "type": "string", "pattern": "^https://" },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "textRankMarker": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "emojiRankMarker": {
      "type": "object",
      "required": ["type", "emoji", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "emoji" },
        "emoji": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "rankMarker": {
      "oneOf": [
        { "$ref": "#/$defs/bundledRankMarker" },
        { "$ref": "#/$defs/imageRankMarker" },
        { "$ref": "#/$defs/textRankMarker" },
        { "$ref": "#/$defs/emojiRankMarker" }
      ]
    },
    "rankDisplay": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "marker": { "$ref": "#/$defs/rankMarker" }
      }
    },
    "leadershipOccupant": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/$defs/rankDisplay" },
        "acting": { "type": "boolean" }
      }
    },
    "leadershipPosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "authorizedRank": { "$ref": "#/$defs/rankDisplay" },
        "occupant": { "$ref": "#/$defs/leadershipOccupant" },
        "vacant": { "type": "boolean" }
      }
    },
    "leadership": {
      "type": "array",
      "items": { "$ref": "#/$defs/leadershipPosition" }
    },
    "taxonomyAssignments": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "comparisonTier": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "taxonomyLevel": {
      "type": "object",
      "required": ["id", "label", "tier"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "tier": { "$ref": "#/$defs/id" },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "taxonomySystem": {
      "type": "object",
      "required": ["id", "label", "levels"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "levels": { "type": "array", "items": { "$ref": "#/$defs/taxonomyLevel" } },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "taxonomySystemDefinition": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "taxonomyState": {
      "type": "object",
      "required": ["comparisonTiers", "systems"],
      "additionalProperties": false,
      "properties": {
        "comparisonTiers": { "type": "array", "items": { "$ref": "#/$defs/comparisonTier" } },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/taxonomySystem" } }
      }
    },
    "nodeState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" },
        "leadership": { "$ref": "#/$defs/leadership" },
        "taxonomyAssignments": { "$ref": "#/$defs/taxonomyAssignments" },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "nodeDefinition": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "symbol": { "$ref": "#/$defs/symbol" },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" },
        "leadership": { "$ref": "#/$defs/leadership" },
        "taxonomyAssignments": { "$ref": "#/$defs/taxonomyAssignments" },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "hierarchyEdge": {
      "type": "object",
      "required": ["child", "parent", "relationship"],
      "additionalProperties": false,
      "properties": {
        "child": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "relationship": { "enum": ["internal", "subordinate"] },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "source", "target", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "partialRelationship": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "snapshotState": {
      "type": "object",
      "required": ["nodes", "hierarchy"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/nodeState" }
        },
        "hierarchy": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyEdge" }
        },
        "taxonomy": { "$ref": "#/$defs/taxonomyState" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "label", "nodes", "hierarchy"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/nodeState" }
        },
        "hierarchy": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyEdge" }
        },
        "taxonomy": { "$ref": "#/$defs/taxonomyState" }
      }
    },
    "patchNote": { "type": "string" },
    "patchSemantic": { "type": "string", "minLength": 1 },
    "patchRelatedNodes": {
        "type": "array",
        "items": { "$ref": "#/$defs/id" },
        "uniqueItems": true
    },
    "addNodePatch": {
      "type": "object",
      "required": ["type", "node"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "add-node" },
        "node": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/nodeState" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "removeNodePatch": {
      "type": "object",
      "required": ["type", "node"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "remove-node" },
        "node": { "$ref": "#/$defs/id" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "setNodePatch": {
      "type": "object",
      "required": ["type", "node", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "set-node" },
        "node": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/nodeState" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "setParentPatch": {
      "type": "object",
      "required": ["type", "node", "parent", "relationship"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "set-parent" },
        "node": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "relationship": { "enum": ["internal", "subordinate"] },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "removeParentPatch": {
      "type": "object",
      "required": ["type", "node"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "remove-parent" },
        "node": { "$ref": "#/$defs/id" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "addRelationshipPatch": {
      "type": "object",
      "required": ["type", "relationship"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "add-relationship" },
        "relationship": { "$ref": "#/$defs/relationship" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "removeRelationshipPatch": {
      "type": "object",
      "required": ["type", "relationship"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "remove-relationship" },
        "relationship": { "$ref": "#/$defs/id" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "setRelationshipPatch": {
      "type": "object",
      "required": ["type", "relationship", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "set-relationship" },
        "relationship": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/partialRelationship" },
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "patchDetails": {
      "type": "object",
      "properties": {
        "note": { "$ref": "#/$defs/patchNote" },
        "sources": { "$ref": "#/$defs/sources" },
        "semantic": { "$ref": "#/$defs/patchSemantic" },
        "relatedNodes": { "$ref": "#/$defs/patchRelatedNodes" }
      }
    },
    "partialComparisonTier": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "partialTaxonomySystem": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "partialTaxonomyLevel": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "tier": { "$ref": "#/$defs/id" },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "taxonomyPatch": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/patchDetails" },
        {
          "oneOf": [
            {
              "required": ["type", "tier"],
              "properties": {
                "type": { "const": "add-comparison-tier" },
                "tier": { "$ref": "#/$defs/comparisonTier" }
              }
            },
            {
              "required": ["type", "tier", "value"],
              "properties": {
                "type": { "const": "set-comparison-tier" },
                "tier": { "$ref": "#/$defs/id" },
                "value": { "$ref": "#/$defs/partialComparisonTier" }
              }
            },
            {
              "required": ["type", "tier"],
              "properties": {
                "type": { "const": "remove-comparison-tier" },
                "tier": { "$ref": "#/$defs/id" }
              }
            },
            {
              "required": ["type", "tiers"],
              "properties": {
                "type": { "const": "set-comparison-tier-order" },
                "tiers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
              }
            },
            {
              "required": ["type", "taxonomy"],
              "properties": {
                "type": { "const": "add-taxonomy-system" },
                "taxonomy": { "$ref": "#/$defs/taxonomySystemDefinition" }
              }
            },
            {
              "required": ["type", "taxonomy", "value"],
              "properties": {
                "type": { "const": "set-taxonomy-system" },
                "taxonomy": { "$ref": "#/$defs/id" },
                "value": { "$ref": "#/$defs/partialTaxonomySystem" }
              }
            },
            {
              "required": ["type", "taxonomy"],
              "properties": {
                "type": { "const": "remove-taxonomy-system" },
                "taxonomy": { "$ref": "#/$defs/id" }
              }
            },
            {
              "required": ["type", "taxonomy", "level"],
              "properties": {
                "type": { "const": "add-taxonomy-level" },
                "taxonomy": { "$ref": "#/$defs/id" },
                "level": { "$ref": "#/$defs/taxonomyLevel" }
              }
            },
            {
              "required": ["type", "taxonomy", "level", "value"],
              "properties": {
                "type": { "const": "set-taxonomy-level" },
                "taxonomy": { "$ref": "#/$defs/id" },
                "level": { "$ref": "#/$defs/id" },
                "value": { "$ref": "#/$defs/partialTaxonomyLevel" }
              }
            },
            {
              "required": ["type", "taxonomy", "level"],
              "properties": {
                "type": { "const": "remove-taxonomy-level" },
                "taxonomy": { "$ref": "#/$defs/id" },
                "level": { "$ref": "#/$defs/id" }
              }
            },
            {
              "required": ["type", "node", "taxonomy", "level"],
              "properties": {
                "type": { "const": "set-taxonomy-assignment" },
                "node": { "$ref": "#/$defs/id" },
                "taxonomy": { "$ref": "#/$defs/id" },
                "level": { "$ref": "#/$defs/id" }
              }
            },
            {
              "required": ["type", "node", "taxonomy"],
              "properties": {
                "type": { "const": "remove-taxonomy-assignment" },
                "node": { "$ref": "#/$defs/id" },
                "taxonomy": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      ]
    },
    "patch": {
      "oneOf": [
        { "$ref": "#/$defs/addNodePatch" },
        { "$ref": "#/$defs/removeNodePatch" },
        { "$ref": "#/$defs/setNodePatch" },
        { "$ref": "#/$defs/setParentPatch" },
        { "$ref": "#/$defs/removeParentPatch" },
        { "$ref": "#/$defs/addRelationshipPatch" },
        { "$ref": "#/$defs/removeRelationshipPatch" },
        { "$ref": "#/$defs/setRelationshipPatch" },
        { "$ref": "#/$defs/taxonomyPatch" }
      ]
    },
    "patchGroup": {
      "type": "object",
      "required": ["id", "label", "patches"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } },
        "defaultSelected": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "conflictsWith": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "proposal": {
      "type": "object",
      "required": ["id", "label", "base"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/id" },
        "snapshot": { "$ref": "#/$defs/snapshotState" },
        "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } },
        "patchGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/patchGroup" }
        }
      }
    },
    "zone": {
      "type": "object",
      "required": ["id", "label", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fill": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layoutMode": { "enum": ["depth", "taxonomy"] },
        "transitionDurationMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "initialExpansionDepth": { "type": "integer", "minimum": 0 },
        "focusNodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    }
  }
}
