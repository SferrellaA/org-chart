      "taxonomyAssignments": { "usaf-echelon": "numbered-air-force" }
    },
    "second-af": {
      "name": "Second Air Force",
      "note": "SAC numbered air force transferred to ACC on 1 June 1992 and initially concentrated strategic reconnaissance forces.",
