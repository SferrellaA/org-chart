  "title": "1992 U.S. Air Force command reorganization (working reconstruction)",
  "nodes": {
    "sac": {
      "name": "Strategic Air Command",
      "note": "Representative pre-reorganization root. SAC was inactivated on 1 June 1992; combat, reconnaissance, and missile forces moved to ACC while tanker forces moved principally to AMC.",
      "sources": [{ "label": "ACC History", "url": "https://www.acc.af.mil/About-Us/ACC-History/" }],
      "taxonomyAssignments": { "usaf-echelon": "major-command" }
    },
    "tac": {
      "name": "Tactical Air Command",
      "note": "Representative pre-reorganization root. TAC was inactivated and Air Combat Command activated on 1 June 1992.",
      "sources": [{ "label": "AFHRA Air Combat Command lineage", "url": "https://www.dafhistory.af.mil/About-Us/Fact-Sheets/Display/Article/432046/air-combat-command-usaf/" }],
      "taxonomyAssignments": { "usaf-echelon": "major-command" }
    },
    "acc": {
      "name": "Air Combat Command",
      "note": "Activated on 1 June 1992 to integrate TAC forces with most SAC combat resources.",
      "sources": [{ "label": "AFHRA Air Combat Command lineage", "url": "https://www.dafhistory.af.mil/About-Us/Fact-Sheets/Display/Article/432046/air-combat-command-usaf/" }],
      "taxonomyAssignments": { "usaf-echelon": "major-command" }
    },
    "amc": {
      "name": "Air Mobility Command",
      "note": "Activated on 1 June 1992 from Military Airlift Command and SAC tanker resources. Only former SAC wings in the tracked cohort appear here.",
      "sources": [{ "label": "AFHRA Air Mobility Command lineage", "url": "https://www.dafhistory.af.mil/About-Us/Fact-Sheets/Display/Article/968648/air-mobility-command/" }],
      "taxonomyAssignments": { "usaf-echelon": "major-command" }
    },
    "first-af": {
      "name": "First Air Force",
      "note": "TAC numbered air force transferred to ACC in the 1992 reorganization.",
